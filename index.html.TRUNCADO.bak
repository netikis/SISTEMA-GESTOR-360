    <datalist id="doc-sugestoes-nomes">
        <option value="Documento de identidade"></option>
        <option value="Conta de luz"></option>
        <option value="Conta de água"></option>
        <option value="CNH"></option>
        <option value="CPF"></option>
        <option value="Comprovante de residência"></option>
        <option value="Contrato"></option>
        <option value="Holerite"></option>
    </datalist>

    <div id="aba-backup" class="view-section">
        <div class="card-alerta-backup">
            <h3 style="color: var(--dark-navy); margin-top: 0;">💾 Gestão de Armazenamento</h3>
            <p class="texto-explicacao" style="text-align: justify; margin-bottom: 20px;">
                Para manter o seu sistema rápido e evitar cobranças de servidor do Google devido ao excesso de fotos pesadas, recomendamos que, ao fechar o mês, baixe o Backup Completo Offline e, em seguida, faça a Limpeza da Nuvem.
            </p>

            <div style="display: flex; gap: 10px; text-align: left;">
                <div style="flex: 1.5;">
                    <label>Mês do Backup</label>
                    <select id="backup-mes">
                        <option value="01">Janeiro</option>
                        <option value="02">Fevereiro</option>
                        <option value="03">Março</option>
                        <option value="04">Abril</option>
                        <option value="05">Maio</option>
                        <option value="06">Junho</option>
                        <option value="07">Julho</option>
                        <option value="08">Agosto</option>
                        <option value="09">Setembro</option>
                        <option value="10">Outubro</option>
                        <option value="11">Novembro</option>
                        <option value="12">Dezembro</option>
                    </select>
                </div>
                <div style="flex: 1;">
                    <label>Ano</label>
                    <input type="number" id="backup-ano" value="2026">
                </div>
            </div>

            <button class="btn-entrada" onclick="fazerBackupMes()" style="box-shadow: none;">⬇️ 1º PASSO: BAIXAR BACKUP (OFFLINE)</button>
            <p class="texto-explicacao" style="margin-top: 5px;">* Salva todas as fotos de pontos, vales e despesas em um arquivo seguro no seu computador.</p>

            <button class="btn-limpar-nuvem" onclick="limparDadosMes()">🗑️ 2º PASSO: APAGAR DADOS (LIMPAR NUVEM)</button>
            <p class="texto-explicacao" style="margin-top: 5px;">* Atenção: Clique apenas após garantir que o arquivo de Backup foi salvo com segurança!</p>
        </div>
    </div>

    <div id="aba-pedidos" class="view-section">
        <div style="background: #eef2f5; padding: 15px; border-radius: 10px; margin-bottom: 20px; text-align: center; border: 1px solid #1a2a43;">
            <h3 style="margin: 0; color: var(--dark-navy);">Gerenciamento de Materiais</h3>
            <p class="texto-explicacao" style="margin-top: 5px; text-align: center;">Acompanhe os pedidos feitos pelas equipes.</p>
            <button class="btn-gold" onclick="buscarPedidosMaterial()" style="margin-top: 10px; padding: 10px;">🔄 ATUALIZAR LISTA</button>
        </div>

        <div id="lista-pedidos-resultados">
            <p style="text-align: center; color: #888; font-size: 13px;">Clique em "Atualizar Lista" para ver os pedidos.</p>
        </div>
    </div>

    </div><!-- gestor-sections-wrap -->
    </div><!-- gestor-main-content -->
    </div><!-- gestor-corpo-painel -->
</div>

