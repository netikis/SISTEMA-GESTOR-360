    <div class="header-logo">
        <img src="https://i.postimg.cc/zDRJMSTn/69420f5a-5b80-457e-8146-00485162d7f2.jpg" crossorigin="anonymous" alt="Logo" class="logo-img">
        <div class="title-top" id="login-nome-empresa">Login do Funcionário</div>
    </div>

    <p style="text-align: center; font-size: 13px; color: #555;">Digite o seu CPF para aceder ao sistema de ponto da empresa.</p>

    <label>Seu CPF (Somente números)</label>
    <input type="text" id="login-cpf" inputmode="numeric" pattern="[0-9]*" placeholder="Apenas números" autocomplete="username">

    <label>Sua Senha</label>
