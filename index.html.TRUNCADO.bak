    const nomeMeses = { 
        "01": "Janeiro", "1": "Janeiro", 
        "02": "Fevereiro", "2": "Fevereiro", 
        "03": "Março", "3": "Março", 
        "04": "Abril", "4": "Abril", 
        "05": "Maio", "5": "Maio", 
        "06": "Junho", "6": "Junho", 
        "07": "Julho", "7": "Julho", 
        "08": "Agosto", "8": "Agosto", 
        "09": "Setembro", "9": "Setembro", 
        "10": "Outubro", "11": "Novembro", "12": "Dezembro" 
    };

function separarDataSegura(dataString) {
    try {
        if (!dataString) {
            return { ano: 'Outros', mes: 'Outros', dia: '??' };
        }
        
        // CORREÇÃO 1: Adicionado o [0] para pegar a string da data antes de usar o replace
        let apenasData = String(dataString).trim().split(' ')[0]; 
        let textoLimpo = apenasData.replace(/[^\d\/\-]/g, '');
        let partes = textoLimpo.split(/[\/\-]/);
        
        if (partes.length >= 3) {
            // CORREÇÃO 2: Pegar os índices corretos da lista (0, 1 e 2)
            let p1 = partes[0]; 
            let p2 = partes[1]; 
            let p3 = partes[2];
            let ano, mes, dia;
            
            if (p3.length >= 4) { 
                ano = p3.substring(0, 4); 
                mes = p2; 
                dia = p1; 
            } else if (p1.length >= 4) { 
                ano = p1.substring(0, 4); 
                mes = p2; 
                dia = p3; 
            } else { 
                ano = "20" + p3; 
                mes = p2; 
                dia = p1; 
            }
            
            return { ano: ano, mes: mes.padStart(2, '0'), dia: dia.padStart(2, '0') };
        }
        return { ano: 'Outros', mes: 'Outros', dia: String(dataString) };
    } catch(e) { 
        console.error("Erro na data:", e);
        return { ano: 'Outros', mes: 'Outros', dia: '??' }; 
    }
}

    /** Coordenadas numéricas válidas para Maps / Firestore; evita gravar texto em latitude/longitude. */
    function normalizarCoordenadasGPS(lat, lng) {
        const la = typeof lat === 'number' ? lat : parseFloat(String(lat).replace(',', '.').trim());
        const lo = typeof lng === 'number' ? lng : parseFloat(String(lng).replace(',', '.').trim());
        if (Number.isFinite(la) && Number.isFinite(lo) && Math.abs(la) <= 90 && Math.abs(lo) <= 180) {
            return { ok: true, lat: la, lng: lo };
        }
        return { ok: false, lat: null, lng: null };
    }

    function montarLinkGoogleMapsOuNull(lat, lng) {
        const g = normalizarCoordenadasGPS(lat, lng);
        if (!g.ok) return null;
        return 'https://www.google.com/maps?q=' + g.lat + ',' + g.lng;
    }

    function textoCoordenadasParaExibicao(dados) {
        const g = normalizarCoordenadasGPS(dados.latitude, dados.longitude);
        if (g.ok) return g.lat + ', ' + g.lng;
        return 'GPS indisponível neste registro';
    }

    /**
     * Mesma lógica “certeira” de antes: pedido de alta precisão primeiro (GPS real).
     * Só depois tenta posição de rede; por último aceita cache recente se ainda não houver fix.
     */
    async function obterCoordenadasGeolocalizacaoRapida() {
        if (!navigator.geolocation) return { lat: null, lng: null };
        function tentar(opcoes) {
            return new Promise(function (resolve, reject) {
                navigator.geolocation.getCurrentPosition(resolve, reject, opcoes);
            });
        }
        const tentativas = [
            { enableHighAccuracy: true, maximumAge: 0, timeout: 12000 },
            { enableHighAccuracy: false, maximumAge: 0, timeout: 8000 },
            { enableHighAccuracy: false, maximumAge: 300000, timeout: 6000 }
        ];
        for (let i = 0; i < tentativas.length; i++) {
            try {
                const pos = await tentar(tentativas[i]);
                const la = pos.coords.latitude;
                const lo = pos.coords.longitude;
                if (Number.isFinite(la) && Number.isFinite(lo)) return { lat: la, lng: lo };
            } catch (err) {
                console.warn('Geolocalização tentativa ' + (i + 1), err && err.code, err && err.message);
            }
        }
        return { lat: null, lng: null };
    }

    function escapeHtmlBasico(s) {
        return String(s || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    /** Converte DD/MM/AAAA ↔ input type="date" (AAAA-MM-DD). */
    function dataBrParaInputDateIso(ddmmyyyy) {
        const p = String(ddmmyyyy || '').trim().split('/');
        if (p.length !== 3) return '';
        const d = String(p[0]).padStart(2, '0');
        const m = String(p[1]).padStart(2, '0');
        const y = String(p[2]);
        if (y.length < 4) return '';
        return `${y}-${m}-${d}`;
    }
    function inputDateIsoParaDataBr(ymd) {
        if (!ymd || String(ymd).indexOf('-') < 0) return '';
        const p = String(ymd).split('-');
        if (p.length !== 3) return '';
        return `${String(p[2]).padStart(2, '0')}/${String(p[1]).padStart(2, '0')}/${p[0]}`;
    }
    function normalizarHoraHHmm(hora) {
        const hp = String(hora || '').trim().split(':');
        const hh = Math.min(23, Math.max(0, parseInt(hp[0], 10) || 0));
        const mm = Math.min(59, Math.max(0, parseInt(hp[1] || '0', 10)));
        return String(hh).padStart(2, '0') + ':' + String(mm).padStart(2, '0');
    }
    /** Data/hora em calendário local (mesmo critério da folha). */
    function parseDataHoraBrLocalParaTimestamp(dataBR, horaHM) {
        const p = String(dataBR || '').trim().split('/');
        if (p.length !== 3) return NaN;
        const dia = parseInt(p[0], 10);
        const mes = parseInt(p[1], 10) - 1;
        const ano = parseInt(p[2], 10);
        const hp = String(horaHM || '00:00').trim().split(':');
        const hh = parseInt(hp[0], 10);
        const mm = parseInt(hp[1] || '0', 10);
        if (!Number.isFinite(dia) || !Number.isFinite(mes) || !Number.isFinite(ano) || !Number.isFinite(hh) || !Number.isFinite(mm)) return NaN;
        const dt = new Date(ano, mes, dia, hh, mm, 0, 0);
        return dt.getTime();
    }

    /** Chave única DD/MM/AAAA para agrupar batidas do mesmo dia na folha. */
    function formatarDataBrPadrao(dataString) {
        const s = separarDataSegura(dataString);
        if (!dataString || s.ano === 'Outros') return String(dataString || '').trim();
        return `${s.dia}/${s.mes}/${s.ano}`;
    }

    /** Unifica variações de texto (acentos, maiúsculas) nos tipos de batida. */
    function normalizarTipoBatidaPonto(tipo) {
        const t = String(tipo || '').trim().toLowerCase()
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        if (t === 'entrada') return 'Entrada';
        if (t === 'saida' || t === 'saida final' || t === 'sair') return 'Saída';
        if (t === 'inicio intervalo' || t === 'intervalo' || t === 'almoco' || t === 'saida almoco') return 'Início Intervalo';
        if (t === 'fim intervalo' || t === 'volta' || t === 'retorno' || t === 'retorno intervalo' || t === 'volta almoco') return 'Fim Intervalo';
        return String(tipo || '').trim();
    }

    function resumoBatidasDiaParaFolha(batidasRaw) {
        const dedup = deduplicarBatidasPonto(batidasRaw, null);
        const batidas = (dedup.validas || [])
            .map(b => (b ? { ...b, tipo: normalizarTipoBatidaPonto(b.tipo) } : b))
            .filter(b => b && ['Entrada', 'Saída', 'Início Intervalo', 'Fim Intervalo'].includes(b.tipo))
            .sort((a, b) => (Number(a.timestamp) || 0) - (Number(b.timestamp) || 0));
        if (!batidas.length) return 'Nenhuma batida válida (ou todas canceladas).';
        const tipos = new Set(batidas.map(b => b.tipo));
        const faltam = [];
        if (!tipos.has('Entrada')) faltam.push('Entrada');
        if (!tipos.has('Saída')) faltam.push('Saída');
        if (tipos.has('Início Intervalo') && !tipos.has('Fim Intervalo')) faltam.push('Fim intervalo');
        if (tipos.has('Fim Intervalo') && !tipos.has('Início Intervalo')) faltam.push('Início intervalo');
        const lista = batidas.map(b => `${b.tipo} ${b.hora || '?'}`).join('; ');
        if (!faltam.length) return `Batidas: ${lista}.`;
        return `Batidas: ${lista}. Falta(m) no dia: ${faltam.join(', ')}.`;
    }

    function horariosJornadaPadraoFuncionario(func, dataBR) {
        const he = normalizarHoraHHmm(func.hora_entrada || '07:30');
        const hs = normalizarHoraHHmm(func.hora_saida || '17:00');
        const intMin = Math.max(0, Number(func.intervalo_minutos ?? 60));
        const tsEnt = parseDataHoraBrLocalParaTimestamp(dataBR, he);
        const tsSai = parseDataHoraBrLocalParaTimestamp(dataBR, hs);
        let inicioInt = '12:00';
        let fimInt = '13:00';
        if (Number.isFinite(tsEnt) && Number.isFinite(tsSai) && tsSai > tsEnt) {
            const meio = tsEnt + (tsSai - tsEnt) / 2;
            const dtMeio = new Date(meio);
            inicioInt = normalizarHoraHHmm(`${dtMeio.getHours()}:${dtMeio.getMinutes()}`);
            const dtFim = new Date(meio + intMin * 60000);
            fimInt = normalizarHoraHHmm(`${dtFim.getHours()}:${dtFim.getMinutes()}`);
        }
        return { entrada: he, inicioIntervalo: inicioInt, fimIntervalo: fimInt, saida: hs };
    }

    /** Funcionário ativo no contexto RH (folha, ponto, etc.). */
    function obterFuncionarioIdContextoRH() {
        if (window.ultimoFuncIdFolha) return window.ultimoFuncIdFolha;
        const ordem = ['folha-func-select', 'pt-func-select', 'p-func-select', 'b-func-select', 'ac-func-select', 'df-func-select'];
        for (let i = 0; i < ordem.length; i++) {
            const el = document.getElementById(ordem[i]);
            if (el && el.value) return el.value;
        }
        return '';
    }

    function registrarFuncionarioContextoRH(funcId) {
        if (!funcId) return;
        window.ultimoFuncIdFolha = funcId;
        ['folha-func-select', 'pt-func-select', 'p-func-select', 'b-func-select'].forEach(function (id) {
            const el = document.getElementById(id);
            if (el) el.value = funcId;
        });
    }

    function vincularSelectsFuncionarioContextoRH() {
        ['folha-func-select', 'pt-func-select'].forEach(function (id) {
            const el = document.getElementById(id);
            if (!el || el.dataset.ctxRhBound === '1') return;
            el.dataset.ctxRhBound = '1';
            el.addEventListener('change', function () {
                if (el.value) registrarFuncionarioContextoRH(el.value);
            });
        });
    }

    function initFolhaOpcoesCalculo() {
        const elEx = document.getElementById('folha-opc-extras');
        const elDc = document.getElementById('folha-opc-desconto-horas');
        if (!elEx || !elDc) return;
        const sEx = localStorage.getItem('folha_incluir_extras');
        const sDc = localStorage.getItem('folha_incluir_desconto_horas');
        if (sEx !== null) elEx.checked = sEx === '1';
        if (sDc !== null) elDc.checked = sDc === '1';
        const gravar = function () {
            localStorage.setItem('folha_incluir_extras', elEx.checked ? '1' : '0');
            localStorage.setItem('folha_incluir_desconto_horas', elDc.checked ? '1' : '0');
        };
        if (elEx.dataset.folhaOpcBound !== '1') {
            elEx.dataset.folhaOpcBound = '1';
            elDc.dataset.folhaOpcBound = '1';
            elEx.addEventListener('change', gravar);
            elDc.addEventListener('change', gravar);
        }
    }

    function lerFolhaOpcoesCalculo() {
        const elEx = document.getElementById('folha-opc-extras');
        const elDc = document.getElementById('folha-opc-desconto-horas');
        return {
            incluirExtras: elEx ? elEx.checked : true,
            incluirDescontoHoras: elDc ? elDc.checked : true
        };
    }

    function isoParaDataBr(iso) {
        if (!iso || String(iso).indexOf('-') < 0) return '';
        const p = String(iso).split('-');
        return `${p[2]}/${p[1]}/${p[0]}`;
    }

    function chaveSemanaDsrDomingo(isoOuDate) {
        const dt = typeof isoOuDate === 'string' ? isoParaDateLocal(isoOuDate) : isoOuDate;
        if (!dt) return '';
        const d = new Date(dt.getTime());
        d.setDate(d.getDate() - d.getDay());
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }

    /** DSR perdido: 1 descanso (domingo) por semana com falta injustificada em dia devido (CLT / Súmula 146). */
    function calcularDsrPerdidosPorFaltas(faltasIsoLista, anoNum, mesNum, diasNoMesCalc, admIso, demIso) {
        const semanasComFalta = new Set();
        (faltasIsoLista || []).forEach(function (iso) {
            if (!iso || !isDiaContratoAtivo(iso, admIso, demIso)) return;
            const k = chaveSemanaDsrDomingo(iso);
            if (k) semanasComFalta.add(k);
        });
        const domingosPerdidos = [];
        for (let d = 1; d <= diasNoMesCalc; d++) {
            const isoD = `${anoNum}-${String(mesNum).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
            const dt = new Date(anoNum, mesNum - 1, d);
            if (dt.getDay() !== 0) continue;
            if (!isDiaContratoAtivo(isoD, admIso, demIso)) continue;
            const semKey = chaveSemanaDsrDomingo(isoD);
            if (semanasComFalta.has(semKey)) {
                domingosPerdidos.push({ iso: isoD, dataBr: isoParaDataBr(isoD), semana: semKey });
            }
        }
        return { dsrPerdidos: domingosPerdidos.length, domingosPerdidos: domingosPerdidos };
    }

    function eventoFaltaNoMes(ev, mesSelected, anoSelected) {
        if (!ev) return false;
        let iso = ev.data_iso || '';
        if (!iso && ev.data_br) {
            const br = formatarDataBrPadrao(ev.data_br);
            const s = separarDataSegura(br);
            if (s.ano !== 'Outros') iso = `${s.ano}-${s.mes}-${s.dia}`;
        }
        if (!iso) return false;
        const p = iso.split('-');
        return Number(p[1]) === Number(mesSelected) && Number(p[0]) === Number(anoSelected);
    }

    function indexarEventosFaltasRh(snapEvt, mesSelected, anoSelected) {
        const injust = new Map();
        const just = new Map();
        snapEvt.forEach(function (ed) {
            const ev = ed.data();
            if (!ev || !eventoFaltaNoMes(ev, mesSelected, anoSelected)) return;
            let iso = ev.data_iso || '';
            if (!iso && ev.data_br) {
                const br = formatarDataBrPadrao(ev.data_br);
                const s = separarDataSegura(br);
                if (s.ano !== 'Outros') iso = `${s.ano}-${s.mes}-${s.dia}`;
            }
            if (!iso) return;
            const item = {
                id: ed.id,
                motivo: ev.motivo || '',
                iso: iso,
                dataBr: isoParaDataBr(iso),
                descontarDsr: ev.descontar_dsr !== false
            };
            if (ev.tipo === 'FALTA_INJUSTIFICADA') injust.set(iso, item);
            if (ev.tipo === 'FALTA_JUSTIFICADA') just.set(iso, item);
        });
        return { injust: injust, just: just };
    }

    function obterIsoHojeLocal() {
        const ag = new Date();
        return `${ag.getFullYear()}-${String(ag.getMonth() + 1).padStart(2, '0')}-${String(ag.getDate()).padStart(2, '0')}`;
    }

    /** Hoje e dias futuros sem ponto não viram falta automática — só após a data passar. */
    function diaAguardandoPontoFolha(isoD, hojeIso, marcadaRhInjust, marcadaRhJust, workedD) {
        if (marcadaRhInjust || marcadaRhJust) return false;
        if ((Number(workedD) || 0) > 0) return false;
        return isoD >= hojeIso;
    }

    function ehFaltaInjustificadaNoDia(isoD, workedD, faltasRhInjust, faltasRhJust, hojeIso) {
        if (faltasRhJust && faltasRhJust.has(isoD)) return false;
        if (faltasRhInjust && faltasRhInjust.has(isoD)) return true;
        const hoje = hojeIso || obterIsoHojeLocal();
        if (isoD >= hoje) return false;
        return workedD <= 0;
    }

    /** Falta automática (sem RH) sempre desconta DSR; RH pode optar por não descontar DSR no registro. */
    function faltaInjustDescontaDsr(evRh, marcadaRhInjust) {
        if (!marcadaRhInjust) return true;
        if (!evRh) return true;
        return evRh.descontarDsr !== false;
    }

    function textoDescontoFaltaInjust(marcadaRhInjust, evRh, textoBaseAutomatico, resumoExtra) {
        const comDsr = faltaInjustDescontaDsr(evRh, marcadaRhInjust);
        const motivoTxt = evRh && evRh.motivo ? ' — ' + evRh.motivo : '';
        const base = marcadaRhInjust
            ? 'Falta injustificada registada pelo RH' + motivoTxt + '.'
            : textoBaseAutomatico;
        const extra = resumoExtra ? ' ' + resumoExtra : '';
        if (comDsr) {
            return base + ' Desconto: 1 dia + DSR da semana (se domingo no mês).' + extra;
        }
        return base + ' Desconto: 1 dia apenas (RH optou por não descontar DSR).' + extra;
    }

    /** Quantidade de dias do mês no calendário (mes 1–12). Maio/2026 = 31. */
    function diasNoCalendarioMes(ano, mes1a12) {
        const y = parseInt(String(ano), 10);
        const m = parseInt(String(mes1a12), 10);
        if (!Number.isFinite(y) || !Number.isFinite(m) || m < 1 || m > 12) return 0;
        return new Date(y, m, 0).getDate();
    }

    function parseDataIsoFuncionario(campo) {
        if (!campo) return null;
        const s = String(campo).trim();
        if (!s) return null;
        if (s.indexOf('-') >= 0) return s.substring(0, 10);
        const br = dataBrParaInputDateIso(s);
        return br || null;
    }

    function isoParaDateLocal(iso) {
        if (!iso) return null;
        const p = String(iso).split('-').map(Number);
        if (p.length !== 3 || !Number.isFinite(p[0])) return null;
        return new Date(p[0], p[1] - 1, p[2], 12, 0, 0, 0);
    }

    function formatarDataBrDeIso(iso) {
        if (!iso) return '—';
        const p = String(iso).split('-');
        if (p.length !== 3) return iso;
        return `${p[2]}/${p[1]}/${p[0]}`;
    }

    function isDiaContratoAtivo(isoD, admIso, demIso) {
        if (admIso && isoD < admIso) return false;
        if (demIso && isoD > demIso) return false;
        return true;
    }

    function isDiaEmFerias(isoD, inicioFeriasIso, diasFerias) {
        if (!inicioFeriasIso) return false;
        const ini = isoParaDateLocal(inicioFeriasIso);
        if (!ini) return false;
        const dias = Math.min(30, Math.max(1, Number(diasFerias) || 30));
        const fim = new Date(ini.getTime());
        fim.setDate(fim.getDate() + dias - 1);
        const cur = isoParaDateLocal(isoD);
        if (!cur) return false;
        return cur >= ini && cur <= fim;
    }

    function normalizarTipoRemuneracao(tipo) {
        const s = String(tipo || 'ponto').toLowerCase().trim();
        return s === 'mensal' ? 'mensal' : 'ponto';
    }

    function labelTipoRemuneracao(tipo) {
        return normalizarTipoRemuneracao(tipo) === 'mensal' ? 'Mensal (CLT)' : 'Por ponto';
    }

    function isDiaUtilTrabalhoFolha(dowD, isoD, feriadosSet, sabadoHorasPadrao) {
        if (dowD === 0 || feriadosSet.has(isoD)) return false;
        if (dowD === 6 && !(Number.isFinite(sabadoHorasPadrao) && sabadoHorasPadrao > 0)) return false;
        return true;
    }

    function mesCalendarioInteiroNoVinculo(anoNum, mesNum, diasNoMesCalc, admIso, demIso) {
        const pad2 = (n) => String(n).padStart(2, '0');
        const primeiro = `${anoNum}-${pad2(mesNum)}-01`;
        const ultimo = `${anoNum}-${pad2(mesNum)}-${pad2(diasNoMesCalc)}`;
        return isDiaContratoAtivo(primeiro, admIso, demIso) && isDiaContratoAtivo(ultimo, admIso, demIso);
    }

    window.mascaraMoeda = function(input) {
        let value = input.value.replace(/\D/g, '');
        if (value === "") { input.value = ""; return; }
        value = (value / 100).toFixed(2) + '';
        value = value.replace('.', ',');
        value = value.replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.');
        input.value = value;
    };

    function formatarMoeda(valor) {
        return valor.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    function parseMoedaLocal(stringValor) {
        if (!stringValor) return 0;
        let limpo = String(stringValor).replace(/\./g, '').replace(',', '.');
        return parseFloat(limpo) || 0;
    }

    function normalizarCpfSomenteDigitos(valor) {
        if (valor == null || valor === '') return '';
        // Número vindo do Firestore (evita notação científica em string)
        if (typeof valor === 'number' && Number.isFinite(valor)) {
            return String(Math.trunc(Math.abs(valor)));
        }
        let s = String(valor).trim();
        // Ex.: "1.2345678901e+10" → converte para inteiro
        if (/e\+/i.test(s)) {
            const n = Number(s);
            if (Number.isFinite(n)) return String(Math.trunc(Math.abs(n)));
        }
        return s.replace(/\D/g, '');
    }

    /** Compara CPF ignorando pontuação e zeros à esquerda (ex.: 0123... vs 123...). */
    function cpfParaComparacao(valor) {
        let digitos = normalizarCpfSomenteDigitos(valor);
        if (!digitos) return '';
        // Firestore/número antigo pode ter perdido zero à esquerda — alinha em 11 dígitos
        if (digitos.length < 11) digitos = digitos.padStart(11, '0');
        if (digitos.length > 11) digitos = digitos.slice(-11);
        return digitos;
    }

    function obterCpfDoFuncionario(dados) {
        if (!dados) return '';
        const bruto = dados.cpf != null ? dados.cpf
            : (dados.CPF != null ? dados.CPF
                : (dados.documento != null ? dados.documento : ''));
        return bruto;
    }

    function cpfsSaoIguais(a, b) {
        const da = normalizarCpfSomenteDigitos(a);
        const db = normalizarCpfSomenteDigitos(b);
        if (!da || !db) return false;
        if (da === db) return true;
        // Também compara com 11 dígitos (zero à esquerda)
        const ca = cpfParaComparacao(a);
        const cb = cpfParaComparacao(b);
        return Boolean(ca && cb && ca === cb);
    }

    function empresasSaoIguais(a, b) {
        return normalizarTextoSemAcentoLower(a) === normalizarTextoSemAcentoLower(b);
    }

    function resolverEmpresaLoginFuncionario() {
        let emp = getSessaoFunc('empresaTemporariaFuncionario');
        if (emp) return String(emp).trim();
        try {
            emp = localStorage.getItem('empresaTemporariaFuncionario');
            if (emp) {
                setSessaoFunc('empresaTemporariaFuncionario', emp);
                return String(emp).trim();
            }
        } catch (_) {}
        const el = document.getElementById('login-nome-empresa');
        const txt = el ? String(el.textContent || '').trim() : '';
        if (txt && txt !== 'Login do Funcionário') return txt;
        return '';
    }

    function normalizarSenhaFuncionario(valor) {
        return String(valor || '').trim();
    }

    function senhaFuncionarioEstaVazia(senha) {
        return senha == null || normalizarSenhaFuncionario(senha) === '';
    }

    function senhasFuncionarioCoincidem(armazenada, digitada) {
        const a = normalizarSenhaFuncionario(armazenada);
        const b = normalizarSenhaFuncionario(digitada);
        if (!a || !b) return false;
        return a.toLowerCase() === b.toLowerCase();
    }

    function normalizarTextoSemAcentoLower(s) {
        return String(s || '')
            .trim()
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '');
    }

    // INSS (empregado CLT) — Tabela progressiva válida a partir da competência JAN/2026
    // Fonte: https://www.gov.br/inss/.../tabela-de-contribuicao-mensal (Atualizado em 13/01/2026)
    const TABELA_INSS_EMPREGADO_2026 = [
        { ate: 1621.00, aliquota: 0.075 },
        { ate: 2902.84, aliquota: 0.09 },
        { ate: 4354.27, aliquota: 0.12 },
        { ate: 8475.55, aliquota: 0.14 }
    ];

    function calcularInssEmpregado2026(salarioContribuicao) {
        const base = Math.max(0, Number(salarioContribuicao) || 0);
        if (!base) return 0;
        let restante = Math.min(base, TABELA_INSS_EMPREGADO_2026[TABELA_INSS_EMPREGADO_2026.length - 1].ate);
        let anterior = 0;
        let total = 0;
        for (const fx of TABELA_INSS_EMPREGADO_2026) {
            if (restante <= 0) break;
            const teto = fx.ate;
            const faixaValor = Math.max(0, Math.min(restante, teto) - anterior);
            if (faixaValor > 0) total += faixaValor * fx.aliquota;
            anterior = teto;
        }
        // Arredondamento padrão a centavos
        return Math.round(total * 100) / 100;
    }

    window.calcularInssEmpregado2026 = calcularInssEmpregado2026;

    function timestampMeioDiaDataIso(ymd) {
        const p = String(ymd || '').split('-');
        if (p.length !== 3) return Date.now();
        const y = parseInt(p[0], 10);
        const m = parseInt(p[1], 10) - 1;
        const dd = parseInt(p[2], 10);
        if (!Number.isFinite(y) || !Number.isFinite(m) || !Number.isFinite(dd)) return Date.now();
        return new Date(y, m, dd, 12, 0, 0).getTime();
    }

    function obterDataVencimentoDespesa(d) {
        if (!d) return '';
        const v = d.data_vencimento ?? d.vencimento ?? d.dataVencimento ?? '';
        return v == null ? '' : v;
    }

    /** Converte vencimento em timestamp (ms). ISO tem prioridade; aceita BR, traços e Timestamp Firestore. */
    function parseDataVencimentoParaTimestamp(dataVenc) {
        if (dataVenc == null || dataVenc === '') return null;

        if (typeof dataVenc === 'number' && Number.isFinite(dataVenc)) {
            if (dataVenc > 1e11) return dataVenc;
            const s = String(Math.floor(dataVenc));
            if (s.length === 8) {
                const y = parseInt(s.slice(0, 4), 10);
                const m = parseInt(s.slice(4, 6), 10) - 1;
                const d = parseInt(s.slice(6, 8), 10);
                return new Date(y, m, d, 12, 0, 0).getTime();
            }
        }

        if (typeof dataVenc === 'object') {
            if (typeof dataVenc.toDate === 'function') {
                const dt = dataVenc.toDate();
                return new Date(dt.getFullYear(), dt.getMonth(), dt.getDate(), 12, 0, 0).getTime();
            }
            if (dataVenc.seconds != null) {
                const dt = new Date(dataVenc.seconds * 1000);
                return new Date(dt.getFullYear(), dt.getMonth(), dt.getDate(), 12, 0, 0).getTime();
            }
        }

        const s = String(dataVenc).trim();
        if (!s) return null;

        let m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
        if (m) {
            const y = parseInt(m[1], 10);
            const mo = parseInt(m[2], 10) - 1;
            const d = parseInt(m[3], 10);
            if (y >= 1900 && y <= 2100 && mo >= 0 && mo <= 11 && d >= 1 && d <= 31) {
                return new Date(y, mo, d, 12, 0, 0).getTime();
            }
        }

        m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
        if (m) {
            const d = parseInt(m[1], 10);
            const mo = parseInt(m[2], 10) - 1;
            const y = parseInt(m[3], 10);
            if (y >= 1900 && y <= 2100 && mo >= 0 && mo <= 11 && d >= 1 && d <= 31) {
                return new Date(y, mo, d, 12, 0, 0).getTime();
            }
        }

        m = s.match(/^(\d{1,2})-(\d{1,2})-(\d{4})$/);
        if (m) {
            const d = parseInt(m[1], 10);
            const mo = parseInt(m[2], 10) - 1;
            const y = parseInt(m[3], 10);
            if (y >= 1900 && y <= 2100 && mo >= 0 && mo <= 11 && d >= 1 && d <= 31) {
                return new Date(y, mo, d, 12, 0, 0).getTime();
            }
        }

        const { ano, mes, dia } = separarDataSegura(s);
        if (!ano || ano === 'Outros') return null;
        const y = parseInt(ano, 10);
        const mo = parseInt(mes, 10) - 1;
        const d = parseInt(dia, 10);
        if (!Number.isFinite(y) || !Number.isFinite(mo) || !Number.isFinite(d)) return null;
        if (y < 1900 || y > 2100 || mo < 0 || mo > 11 || d < 1 || d > 31) return null;
        return new Date(y, mo, d, 12, 0, 0).getTime();
    }

    function dataVencimentoTsDespesa(d) {
        if (!d) return null;
        const doCampo = parseDataVencimentoParaTimestamp(obterDataVencimentoDespesa(d));
        if (doCampo != null) return doCampo;
        const gravado = d.data_vencimento_ts;
        if (gravado != null && gravado !== '' && Number.isFinite(Number(gravado))) {
            return Number(gravado);
        }
        return null;
    }

    function tsLancamentoDespesa(d) {
        if (!d) return 0;
        if (d.data_lancamento) {
            const t = parseDataVencimentoParaTimestamp(d.data_lancamento);
            if (t != null) return t;
        }
        if (d.timestamp != null && Number.isFinite(Number(d.timestamp))) return Number(d.timestamp);
        return parseDataVencimentoParaTimestamp(d.data) || 0;
    }

    function dataVencimentoParaInputDateIso(dataVenc) {
        const ts = parseDataVencimentoParaTimestamp(dataVenc);
        if (ts != null) {
            const dt = new Date(ts);
            return `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, '0')}-${String(dt.getDate()).padStart(2, '0')}`;
        }
        if (!dataVenc) return '';
        const s = String(dataVenc).trim();
        if (/^\d{4}-\d{1,2}-\d{1,2}$/.test(s)) {
            const p = s.split('-');
            return `${p[0]}-${String(p[1]).padStart(2, '0')}-${String(p[2]).padStart(2, '0')}`;
        }
        return dataBrParaInputDateIso(s);
    }

    function formatarVencimentoIsoParaBR(dataVenc) {
        if (!dataVenc) return '—';
        const ts = parseDataVencimentoParaTimestamp(dataVenc);
        if (ts != null) {
            const dt = new Date(ts);
            const dia = String(dt.getDate()).padStart(2, '0');
            const mes = String(dt.getMonth() + 1).padStart(2, '0');
            const ano = dt.getFullYear();
            return `${dia}/${mes}/${ano}`;
        }
        const { ano, mes, dia } = separarDataSegura(dataVenc);
        if (!ano || ano === 'Outros') return String(dataVenc);
        return `${dia}/${mes}/${ano}`;
    }

    function formatarVencimentoDespesaExibir(d) {
        return formatarVencimentoIsoParaBR(obterDataVencimentoDespesa(d));
    }

    /** Vencimento na tabela: vermelho se pendente e já passou. */
    function formatarVencimentoDespesaExibirHtml(d) {
        const ts = dataVencimentoTsDespesa(d);
        if (ts == null) return escapeHtmlBasico('—');
        const dt = new Date(ts);
        const dia = String(dt.getDate()).padStart(2, '0');
        const mes = String(dt.getMonth() + 1).padStart(2, '0');
        const ano = dt.getFullYear();
        const texto = dia + '/' + mes + '/' + ano;
        const hoje = new Date();
        hoje.setHours(12, 0, 0, 0);
        const vencida = dt.getTime() < hoje.getTime() && String(d.status || 'pendente') !== 'pago';
        if (vencida) {
            return '<span style="font-weight:800;color:#dc3545;">' + escapeHtmlBasico(texto) + '</span>';
        }
        return escapeHtmlBasico(dia + '/' + mes + '/') + '<span style="font-weight:800;color:#1a2a43;">' + ano + '</span>';
    }

    function badgeEstadoRelDespesaHtml(d) {
        const st = d.status === 'pago' ? 'pago' : 'pendente';
        if (st === 'pago') {
            let badgeExtra = '';
            if (d.comprovante_pagamento) {
                const idComp = registrarAnexoParaViewer(d.comprovante_pagamento);
                const rotulo = ehAnexoPdfDataUrl(d.comprovante_pagamento) ? '📄 Ver PDF' : '📎 Ver comprovante';
                badgeExtra = '<br><span style="font-size:10px;color:#28a745;font-weight:700;cursor:pointer;" onclick="abrirAnexoRegistrado(\'' + idComp + '\')">' + rotulo + '</span>';
            } else if (d.baixa_sem_comprovante) {
                badgeExtra = '<br><span style="font-size:10px;color:#856404;">Sem comprovante</span>';
            }
            return '<span style="background:#d4edda;color:#155724;padding:2px 6px;border-radius:4px;font-weight:bold;">Pago</span><br><span style="font-size:10px;color:#666;">' + escapeHtmlBasico(d.data_pagamento || '') + '</span>' + badgeExtra;
        }
        if (despesaEstaVencida(d)) {
            return '<span style="background:#f8d7da;color:#721c24;padding:2px 8px;border-radius:4px;font-weight:bold;">⚠️ VENCIDA</span><br><span style="font-size:10px;color:#dc3545;font-weight:700;">Atrasada — pendente pagamento</span>';
        }
        return '<span style="background:#fff3cd;color:#856404;padding:2px 6px;border-radius:4px;font-weight:bold;">Pendente</span><br><span style="font-size:10px;color:#856404;">No prazo</span>';
    }

    window._relDespOrdemVenc = window._relDespOrdemVenc || 'cronologico';

    function rotuloOrdemVencRelDesp() {
        const m = window._relDespOrdemVenc || 'cronologico';
        if (m === 'vencidos_topo') return 'Vencimento ⚠▲';
        if (m === 'desc') return 'Vencimento ▼';
        return 'Vencimento ▲';
    }

    function aplicarOrdemRelDespVencimento(arr, modo) {
        const m = modo || window._relDespOrdemVenc || 'cronologico';
        if (m === 'vencidos_topo') {
            arr.sort((a, b) => {
                const pa = a.status === 'pago' ? 2 : (despesaEstaVencida(a) ? 0 : 1);
                const pb = b.status === 'pago' ? 2 : (despesaEstaVencida(b) ? 0 : 1);
                if (pa !== pb) return pa - pb;
                const ta = dataVencimentoTsDespesa(a);
                const tb = dataVencimentoTsDespesa(b);
                const va = ta != null ? ta : Number.MAX_SAFE_INTEGER;
                const vb = tb != null ? tb : Number.MAX_SAFE_INTEGER;
                if (va !== vb) return va - vb;
                return String(a.obra_nome || '').localeCompare(String(b.obra_nome || ''), 'pt-BR');
            });
            return;
        }
        if (m === 'desc') {
            arr.sort((a, b) => {
                const ta = dataVencimentoTsDespesa(a);
                const tb = dataVencimentoTsDespesa(b);
                const va = ta != null ? ta : Number.MIN_SAFE_INTEGER;
                const vb = tb != null ? tb : Number.MIN_SAFE_INTEGER;
                if (va !== vb) return vb - va;
                return String(a.obra_nome || '').localeCompare(String(b.obra_nome || ''), 'pt-BR');
            });
            return;
        }
        ordenarRelatorioDespesasPorVencimento(arr);
    }

    window.alternarOrdemVencRelDespesas = function () {
        const modos = ['cronologico', 'vencidos_topo', 'desc'];
        const atual = window._relDespOrdemVenc || 'cronologico';
        const idx = modos.indexOf(atual);
        window._relDespOrdemVenc = modos[(idx + 1) % modos.length];
        if (window._relDespDadosFiltrados && window._relDespDadosFiltrados.length) {
            renderizarTabelaRelatorioDespesas(window._relDespDadosFiltrados.slice());
        } else if (typeof window.carregarRelatorioDespesasTabular === 'function') {
            window.carregarRelatorioDespesasTabular();
        }
    };

    function calcularTotaisResumoDespesas(arr) {
        let somaVencidas = 0;
        let somaAVencer = 0;
        let somaPagas = 0;
        (arr || []).forEach((d) => {
            const valor = Number(d.valor_numero != null ? d.valor_numero : parseMoedaLocal(d.valor_string || 0)) || 0;
            if (d.status === 'pago') {
                somaPagas += valor;
            } else if (despesaEstaVencida(d)) {
                somaVencidas += valor;
            } else {
                somaAVencer += valor;
            }
        });
        return { somaVencidas, somaAVencer, somaPagas };
    }

    function montarHtmlPainelResumoDespesas(somaVencidas, somaAVencer, somaPagas, rotuloTotal) {
        const label = rotuloTotal || 'Total Global da Obra/Loja:';
        return ''
            + '<div style="display:flex; justify-content:space-around; text-align:center; flex-wrap:wrap; gap:10px;">'
            + '<div><span style="font-size:12px; color:#d9534f; font-weight:bold;"><span class="bolinha-resumo" style="background:#dc3545;"></span>Vencido</span><br><b style="color:#d9534f; font-size: 16px;">' + formatarMoeda(somaVencidas) + '</b></div>'
            + '<div><span style="font-size:12px; color:#856404; font-weight:bold;"><span class="bolinha-resumo" style="background:#ffc107;"></span>A Vencer</span><br><b style="color:#856404; font-size: 16px;">' + formatarMoeda(somaAVencer) + '</b></div>'
            + '<div><span style="font-size:12px; color:#155724; font-weight:bold;"><span class="bolinha-resumo" style="background:#28a745;"></span>Já Pago</span><br><b style="color:#28a745; font-size: 16px;">' + formatarMoeda(somaPagas) + '</b></div>'
            + '</div>'
            + '<div style="margin-top:15px; border-top:1px dashed #ccc; padding-top:10px; text-align:center;">'
            + '<span style="font-size:13px; color:#555;">' + escapeHtmlBasico(label) + '</span> <b style="font-size: 16px; color: var(--dark-navy);">' + formatarMoeda(somaVencidas + somaAVencer + somaPagas) + '</b>'
            + '</div>';
    }

    function rotuloResumoRelDespesas(arr, termo) {
        if (!termo) {
            return { rotuloTotal: 'Total Global (resultado da tabela):', subtitulo: '' };
        }
        const termoNorm = normalizarChaveNomeDespesa(termo);
        const fornecedores = [...new Set(arr.map((d) => formatarNomeCanonicoDespesa(d.loja_nome)).filter(Boolean))];
        const obras = [...new Set(arr.map((d) => formatarNomeCanonicoDespesa(d.obra_nome)).filter(Boolean))];
        const fornMatch = fornecedores.filter((f) => normalizarChaveNomeDespesa(f).includes(termoNorm));
        const obraMatch = obras.filter((o) => normalizarChaveNomeDespesa(o).includes(termoNorm));
        if (fornMatch.length === 1 && obraMatch.length <= 1) {
            let sub = '🏪 ' + fornMatch[0];
            if (obraMatch.length === 1) sub += ' — 🏢 ' + obraMatch[0];
            return { rotuloTotal: 'Total Global do Fornecedor:', subtitulo: sub };
        }
        if (obraMatch.length === 1 && fornMatch.length <= 1) {
            return { rotuloTotal: 'Total Global da Obra:', subtitulo: '🏢 ' + obraMatch[0] };
        }
        return { rotuloTotal: 'Total Global (filtro atual):', subtitulo: 'Filtro: ' + formatarNomeCanonicoDespesa(termo) };
    }

    function atualizarPainelResumoRelDespesas(arr) {
        const panel = document.getElementById('resumo-total-rel-despesas');
        const display = document.getElementById('total-gasto-display-rel-desp');
        const subEl = document.getElementById('resumo-rel-desp-subtitulo');
        if (!panel || !display) return;
        if (!arr || !arr.length) {
            panel.style.display = 'none';
            return;
        }
        const termo = document.getElementById('rel-desp-filtro') ? document.getElementById('rel-desp-filtro').value.trim() : '';
        const { rotuloTotal, subtitulo } = rotuloResumoRelDespesas(arr, termo);
        const totais = calcularTotaisResumoDespesas(arr);
        display.innerHTML = montarHtmlPainelResumoDespesas(totais.somaVencidas, totais.somaAVencer, totais.somaPagas, rotuloTotal);
        panel.style.display = 'block';
        if (subEl) {
            if (subtitulo) {
                subEl.textContent = subtitulo;
                subEl.style.display = 'block';
            } else {
                subEl.textContent = '';
                subEl.style.display = 'none';
            }
        }
    }

    function ocultarPainelResumoRelDespesas() {
        const panel = document.getElementById('resumo-total-rel-despesas');
        if (panel) panel.style.display = 'none';
    }

    function renderizarTabelaRelatorioDespesas(arrOrigem) {
        const wrap = document.getElementById('tabela-relatorio-despesas-wrap');
        if (!wrap) return;
        const arr = (arrOrigem || []).slice();
        aplicarOrdemRelDespVencimento(arr, window._relDespOrdemVenc);
        window._despesasRelatorioExport = arr;
        arr.forEach((d) => { window._mapRelatorioDespesasParaEdicao[d.id] = d; });

        if (!arr.length) {
            wrap.innerHTML = '<p style="text-align:center;color:#888;">Nenhum registro com os filtros atuais.</p>';
            wrap.setAttribute('data-rel-desp-carregado', '1');
            ocultarPainelResumoRelDespesas();
            return;
        }

        let html = '';
        if (relatorioDespesasTemVariosAnosVencimento(arr)) {
            html += '<p style="font-size:12px;background:#fff8e6;border:1px solid #ffc107;border-radius:8px;padding:10px;margin:0 0 10px 0;color:#856404;">'
                + '<b>Há vencimentos de anos diferentes.</b> A ordem usa o <b>ano inteiro</b>: '
                + 'junho de <b>2025</b> aparece antes de maio de <b>2026</b>. '
                + 'Itens <b style="color:#dc3545;">VENCIDA</b> estão em vermelho.</p>';
        }
        const tituloOrdem = rotuloOrdemVencRelDesp();
        html += '<table style="width:100%;border-collapse:collapse;font-size:12px;background:#fff;border:1px solid #e0e6ed;">';
        html += '<thead><tr style="background:var(--dark-navy);color:#fff;text-align:left;">';
        html += '<th style="padding:8px;border:1px solid #152a45;">Obra</th>';
        html += '<th style="padding:8px;border:1px solid #152a45;">Nome (fornec.)</th>';
        html += '<th style="padding:8px;border:1px solid #152a45;">Chq. / boleto / NF</th>';
        html += '<th style="padding:8px;border:1px solid #152a45;cursor:pointer;white-space:nowrap;" onclick="alternarOrdemVencRelDespesas()" title="Clique para alternar: cronológico → vencidos primeiro → mais recente">'
            + tituloOrdem + ' <span style="font-size:10px;opacity:0.85;">↕</span></th>';
        html += '<th style="padding:8px;border:1px solid #152a45;">Lançamento</th>';
        html += '<th style="padding:8px;border:1px solid #152a45;">Valor</th>';
        html += '<th style="padding:8px;border:1px solid #152a45;">Estado</th>';
        html += '<th style="padding:8px;border:1px solid #152a45;">Observação</th>';
        html += '<th style="padding:8px;border:1px solid #152a45;">Acções</th></tr></thead><tbody>';

        arr.forEach((d) => {
            const st = d.status === 'pago' ? 'pago' : 'pendente';
            const vencida = st === 'pendente' && despesaEstaVencida(d);
            const trFundo = vencida ? 'background:#fff5f5;border-left:4px solid #dc3545;' : '';
            const badge = badgeEstadoRelDespesaHtml(d);
            const refDoc = escapeHtmlBasico(refChequeBoletoDesp(d));
            const rawObs = String(d.observacao || '').trim();
            const obs = escapeHtmlBasico(rawObs);
            const obsShort = rawObs.length > 100 ? escapeHtmlBasico(rawObs.slice(0, 97)) + '…' : obs;
            const titleObs = escapeAttrBasico(rawObs);
            html += '<tr style="vertical-align:top;border-bottom:1px solid #eee;' + trFundo + '">';
            html += '<td style="padding:6px;border:1px solid #eee;">' + escapeHtmlBasico(d.obra_nome || '') + '</td>';
            html += '<td style="padding:6px;border:1px solid #eee;">' + escapeHtmlBasico(d.loja_nome || '') + '</td>';
            html += '<td style="padding:6px;border:1px solid #eee;">' + refDoc + '</td>';
            html += '<td style="padding:6px;border:1px solid #eee;font-weight:600;white-space:nowrap;">' + formatarVencimentoDespesaExibirHtml(d) + '</td>';
            html += '<td style="padding:6px;border:1px solid #eee;">' + escapeHtmlBasico(diaLancamentoDespExibir(d)) + '</td>';
            html += '<td style="padding:6px;border:1px solid #eee;white-space:nowrap;"><b>R$ ' + escapeHtmlBasico(String(d.valor_string || '0')) + '</b></td>';
            html += '<td style="padding:6px;border:1px solid #eee;">' + badge + '</td>';
            html += '<td style="padding:6px;border:1px solid #eee;max-width:220px;font-size:11px;color:#444;" title="' + titleObs + '">' + (obsShort || '—') + '</td>';
            html += '<td style="padding:6px;border:1px solid #eee;min-width:128px;">';
            html += '<button type="button" onclick="editarDespesaRelatorio(\'' + d.id + '\')" style="display:block;width:100%;margin-bottom:4px;background:#4285F4;color:#fff;border:none;padding:6px;border-radius:6px;font-size:11px;cursor:pointer;">✏️ Editar</button>';
            if (st === 'pendente') {
                html += '<button type="button" onclick="marcarComoPagoRelatorio(\'' + d.id + '\')" style="display:block;width:100%;margin-bottom:4px;background:#28a745;color:#fff;border:none;padding:6px;border-radius:6px;font-size:11px;cursor:pointer;">✅ Pago</button>';
            } else {
                html += '<button type="button" onclick="marcarComoPendenteRelatorio(\'' + d.id + '\')" style="display:block;width:100%;margin-bottom:4px;background:#ffc107;color:#333;border:none;padding:6px;border-radius:6px;font-size:11px;cursor:pointer;">↩️ Pendente</button>';
            }
            html += '<button type="button" onclick="excluirLinhaRelatorioDespesas(\'' + d.id + '\')" style="display:block;width:100%;background:#d9534f;color:#fff;border:none;padding:6px;border-radius:6px;font-size:11px;cursor:pointer;">🗑️ Excluir</button>';
            html += '</td></tr>';
        });
        html += '</tbody></table>';
        wrap.innerHTML = html;
        wrap.setAttribute('data-rel-desp-carregado', '1');
        atualizarPainelResumoRelDespesas(arr);
    }

    function relatorioDespesasTemVariosAnosVencimento(arr) {
        const anos = new Set();
        arr.forEach(d => {
            const ts = dataVencimentoTsDespesa(d);
            if (ts != null) anos.add(new Date(ts).getFullYear());
        });
        return anos.size > 1;
    }

    function despesaEstaVencida(d) {
        const ts = dataVencimentoTsDespesa(d);
        if (ts == null) return false;
        const hoje = new Date();
        hoje.setHours(12, 0, 0, 0);
        return ts < hoje.getTime();
    }

    /** Ordem cronológica de vencimento (mais antigo primeiro); sem data válida vai para o fim. */
    function ordenarRelatorioDespesasPorVencimento(arr) {
        arr.sort((a, b) => {
            const ta = dataVencimentoTsDespesa(a);
            const tb = dataVencimentoTsDespesa(b);
            const va = ta != null ? ta : Number.MAX_SAFE_INTEGER;
            const vb = tb != null ? tb : Number.MAX_SAFE_INTEGER;
            if (va !== vb) return va - vb;
            const la = tsLancamentoDespesa(a);
            const lb = tsLancamentoDespesa(b);
            if (la !== lb) return la - lb;
            return String(a.obra_nome || '').localeCompare(String(b.obra_nome || ''), 'pt-BR')
                || String(a.loja_nome || '').localeCompare(String(b.loja_nome || ''), 'pt-BR');
        });
    }

    function diaLancamentoDespExibir(d) {
        if (d.data_lancamento) {
            const partes = String(d.data_lancamento).split('-');
            if (partes.length === 3) return `${partes[2]}/${partes[1]}/${partes[0]}`;
        }
        return d.data || '—';
    }

    function refChequeBoletoDesp(d) {
        const c = d.cheque_boleto_num != null ? String(d.cheque_boleto_num).trim() : '';
        if (c) return c;
        const n = d.nota_fiscal != null ? String(d.nota_fiscal).trim() : '';
        return n || '—';
    }

    function recarregarRelatorioDespesasTabularSeCarregado() {
        const wrap = document.getElementById('tabela-relatorio-despesas-wrap');
        if (wrap && wrap.getAttribute('data-rel-desp-carregado') === '1' && typeof window.carregarRelatorioDespesasTabular === 'function') {
            window.carregarRelatorioDespesasTabular();
        }
    }

    function escapeAttrBasico(s) {
        return String(s || '')
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/</g, '&lt;');
    }

    /** Linhas do tópico «Relatório de despesas» (separado de `despesas_obras`). */
    const COLECAO_RELATORIO_DESPESAS = 'relatorio_despesas';
    const COLECAO_AJUDA_CUSTO = 'ajuda_custo';
    const COLECAO_DESCONTOS_FOLHA = 'descontos_folha';
    const COLECAO_DOCUMENTOS_PESSOAIS = 'documentos_pessoais';
    const PASTAS_DOCUMENTOS = ['fh', 'hallana', 'felipe', 'wellington'];
    const DOC_PDF_MAX_FIRESTORE_RAW = 600000;
    const DOC_FIRESTORE_MAX_B64 = 850000;
    const MSG_DOC_TAMANHO_MAX = 'O documento deve ser menor que 600 KB. Comprima o PDF ou tire uma foto do documento.';
    const PASTA_LABEL_DOCUMENTOS = { fh: 'FH', hallana: 'HALLANA', felipe: 'FELIPE', wellington: 'WELLINGTON' };

    function formatarVencimentoDocExibir(item) {
        const iso = item && item.data_vencimento;
        if (iso && /^\d{4}-\d{2}-\d{2}$/.test(String(iso))) {
            const p = String(iso).split('-');
            return p[2] + '/' + p[1] + '/' + p[0];
        }
        const ts = item && item.data_vencimento_ts;
        if (ts != null && Number.isFinite(Number(ts))) {
            const dt = new Date(Number(ts));
            return String(dt.getDate()).padStart(2, '0') + '/' + String(dt.getMonth() + 1).padStart(2, '0') + '/' + dt.getFullYear();
        }
        return '—';
    }

    function tsVencimentoDocumentoPessoal(item) {
        if (!item) return null;
        if (item.data_vencimento_ts != null && Number.isFinite(Number(item.data_vencimento_ts))) {
            return Number(item.data_vencimento_ts);
        }
        return parseDataVencimentoParaTimestamp(item.data_vencimento);
    }

    window._documentosPessoaisCache = window._documentosPessoaisCache || {};
    window._documentosPessoaisArquivoCache = window._documentosPessoaisArquivoCache || {};
    window._documentosEmpresaFetchPromise = null;
    window._documentosEmpresaFetchEmpresa = null;
    window._documentosEmpresaFetchTs = 0;

    function invalidarCacheDocumentosPessoaisEmpresa() {
        window._documentosEmpresaFetchPromise = null;
        window._documentosEmpresaFetchEmpresa = null;
        window._documentosEmpresaFetchTs = 0;
        window._documentosPessoaisArquivoCache = {};
        PASTAS_DOCUMENTOS.forEach((p) => { window._documentosPessoaisCache[p] = []; });
    }

    window.invalidarCacheDocumentosPessoaisEmpresa = invalidarCacheDocumentosPessoaisEmpresa;

    function metaDocumentoPessoalFromSnap(docSnap) {
        const d = docSnap.data();
        const id = docSnap.id;
        const pasta = String(d.pasta || '');
        const arquivo = d.arquivo || '';
        if (arquivo) window._documentosPessoaisArquivoCache[id] = arquivo;
        return {
            id,
            nome: d.nome || '',
            mime: d.mime || '',
            thumb: d.thumb || '',
            storage_path: d.storage_path || '',
            data_vencimento: d.data_vencimento || '',
            data_vencimento_ts: d.data_vencimento_ts != null ? d.data_vencimento_ts : null,
            data_cadastro: d.data_cadastro || '',
            pasta,
            tem_arquivo: Boolean(arquivo)
        };
    }

    async function fetchDocumentosPessoaisEmpresa(empresaId, opts) {
        const force = opts && opts.force;
        const agora = Date.now();
        const cacheValido = !force
            && window._documentosEmpresaFetchEmpresa === empresaId
            && window._documentosEmpresaFetchPromise
            && window._documentosEmpresaFetchTs
            && (agora - window._documentosEmpresaFetchTs < 300000);

        if (cacheValido) {
            return window._documentosEmpresaFetchPromise;
        }

        if (!force
            && window._documentosEmpresaFetchPromise
     